# Copy this file to `.env` and fill in your keys.
# `.env` is gitignored -- it will NEVER be committed.
#
# Read on startup by apps/adore_robot/main.py before Flask boots.
# Only keys not already in os.environ are set, so real env vars win.

# DeepSeek V4 Flash (recommended -- cheap, OpenAI-compatible, stable tool calling)
# Per DeepSeek docs: https://api-docs.deepseek.com -- base url is
# https://api.deepseek.com (no /v1) and default model is deepseek-v4-flash.
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# Anthropic Claude (fallback). DeepSeek also offers Anthropic-compat at
# https://api.deepseek.com/anthropic if you want to route Claude SDK to DeepSeek.
# ANTHROPIC_API_KEY=sk-ant-...

# Override model name. Valid DeepSeek values:
#   deepseek-chat       (default; alias -> v4-flash non-thinking, supports forced tool_choice; deprecated 2026-07-24 but works now)
#   deepseek-v4-flash   (gateway defaults this to thinking mode -- BREAKS forced tool_choice)
#   deepseek-v4-pro     (thinking mode, needs "thinking": {"type": "enabled"} param)
#   deepseek-reasoner   (alias for thinking mode, deprecated 2026-07-24)
# Stick with deepseek-chat until we add "thinking":{"type":"disabled"} payload support.
# ADORE_LLM_MODEL=deepseek-chat

# UE5.8 MCP server endpoint (default: http://127.0.0.1:8000/mcp)
# UNREAL_MCP_URL=http://127.0.0.1:8000/mcp

# Pick provider explicitly instead of auto-detect
# ADORE_LLM_PROVIDER=deepseek

# Demo mode -- mirror of captureAIshi DEMOAISHI=1. When 1: shows visible
# DEMO badge in topbar, UE/MCP chip shows 'mock' instead of 'connected',
# any future UE MCP attempts are short-circuited. LLM chat still uses the
# real provider when a key is set.
# DEMOAISHI=1
