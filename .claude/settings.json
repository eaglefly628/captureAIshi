{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Bash",
      "Agent",
      "TodoWrite",
      "WebFetch",
      "WebSearch",
      "NotebookEdit"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(git push --force *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "command": "echo '[AUTO-START] Check SHARED.md TODOs, switch to claudeMainBranch, begin working.'",
        "timeout": 5000
      }
    ],
    "PostToolUse": [
      {
        "event": "Bash",
        "pattern": "git push",
        "command": "python -m utils.feishu_notify 'Code Pushed' \"$(git log --oneline -1)\"",
        "timeout": 15000
      }
    ]
  }
}
