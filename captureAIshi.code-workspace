{
  "folders": [
    {
      "path": ".",
      "name": "captureAIshi"
    }
  ],
  "settings": {
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
    "python.analysis.typeCheckingMode": "basic",
    "python.analysis.extraPaths": ["${workspaceFolder}"],
    "files.exclude": {
      "**/__pycache__": true,
      "**/*.pyc": true,
      ".venv": true,
      "3rdparty/renderdoc": true
    },
    "search.exclude": {
      "3rdparty/renderdoc/**": true,
      ".venv/**": true
    },
    "editor.fontSize": 13,
    "editor.tabSize": 4,
    "editor.formatOnSave": true,
    "[python]": {
      "editor.defaultFormatter": "ms-python.black-formatter"
    },
    "[html]": {
      "editor.defaultFormatter": "vscode.html-language-features"
    }
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Launcher (root main.py)",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/main.py",
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder}"
      },
      {
        "name": "Web UI (capture)",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/apps/capture/web_ui.py",
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder}/apps/capture"
      },
      {
        "name": "Desktop App (capture)",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/apps/capture/desktop_app.py",
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder}/apps/capture"
      },
      {
        "name": "CLI - Dry Run",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/apps/capture/main.py",
        "args": [
          "--driver", "manual",
          "--grabber", "none",
          "--dry-run",
          "--spacing", "5",
          "--volume-min", "-2", "0", "-2",
          "--volume-max", "2", "2", "2",
          "--verbose"
        ],
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder}/apps/capture"
      },
      {
        "name": "CLI - UE5 Capture",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/apps/capture/main.py",
        "args": [
          "--driver", "ue5",
          "--driver-port", "9998",
          "--grabber", "renderdoc",
          "--spacing", "5",
          "--volume-min", "-2", "0", "-2",
          "--volume-max", "2", "2", "2",
          "--verbose"
        ],
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder}/apps/capture"
      }
    ]
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.debugpy",
      "ms-python.black-formatter"
    ]
  }
}
